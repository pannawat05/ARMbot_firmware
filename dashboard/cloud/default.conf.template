# nginx inside the cloud image. The nginx image fills in ${MQTT_WS_UPSTREAM} at start;
# $http_upgrade and friends are nginx variables and stay as they are.
server {
    listen 80;
    root /usr/share/nginx/html;

    # Browsers reach the broker's WebSocket listener through this same port, so the
    # broker's own WebSocket port does not have to be open to the internet.
    location /mqtt {
        proxy_pass http://${MQTT_WS_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # config.json holds the broker settings for this page; never cache it.
    location = /config.json { add_header Cache-Control "no-store"; }
    location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
    location / { try_files $uri /index.html; }
}
