# The page connects to the broker through this dashboard's own /mqtt path (nginx forwards it
# to MQTT_WS_UPSTREAM), so only the dashboard port has to be open. A path starting with "/"
# is used with the page's own host, and becomes wss:// automatically when the page is https.
MQTT_WS_URL=/mqtt
# The broker's WebSocket listener as nginx in this container sees it. host.docker.internal is
# the VM itself (set in docker-compose.cloud.yml, or --add-host=host.docker.internal:host-gateway).
MQTT_WS_UPSTREAM=host.docker.internal:9001
MQTT_USERNAME=pan
MQTT_PASSWORD=change-me
MQTT_PREFIX=armbot
