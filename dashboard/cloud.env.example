# HiveMQ public broker over secure WebSocket (works from http:// and https:// pages).
# No login. MQTT_PREFIX must match "prefix" in the Pi's calibration/mqtt.json.
MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PREFIX=armbot-change-me
# Name in the self-signed certificate made when certs/ is empty.
DOMAIN=arm.panplay-itgoeasy.xyz
